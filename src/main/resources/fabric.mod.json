{
  "schemaVersion": 1,
  "id": "chatsummon",
  "version": "${version}",
  "name": "Chat Summon",
  "description": "Chat-controlled mob summoning mod. Continuously listens and summons mobs at other players' locations when mob names are recognized.",
  "authors": ["nitelyfe-nitelyfe"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/chatsummon/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.nitelyfe.chatsummon.ChatSummonMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.nitelyfe.chatsummon.ChatSummonClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.10",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.5+kotlin.2.4.10",
    "cloth-config": ">=20.0.149"
  },
  "suggests": {}
}